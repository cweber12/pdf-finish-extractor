# Neon PostgreSQL (read-only — used for duplicate detection in the preview panel)
DATABASE_URL=postgresql://user:password@your-neon-host/dbname

# Cloudflare Worker API (handles R2 upload + DB write)
API_BASE_URL=https://your-worker.your-domain.workers.dev

# Firebase auth — run `python scripts/login.py` to populate the token fields
FIREBASE_API_KEY=your_web_api_key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_EMAIL=you@example.com
FIREBASE_REFRESH_TOKEN=           # written by scripts/login.py
FIREBASE_UID=                     # written by scripts/login.py

# FFE context — scopes all uploaded materials to this owner + project
PROJECT_ID=your_project_uuid
